@page "/practice"
@using DuskOfCoding.WebUi.Services
@using DuskOfCoding.WebUi.DTOs
@using DuskOfCoding.WebUi.Resources
@using DuskOfCoding.Domain.Enums
@using Microsoft.CodeAnalysis
@using Microsoft.CodeAnalysis.CSharp
@inject ApiClient Api
@inject IStringLocalizer<SharedResource> L
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>@L["Practice_Title"] | Dusk of Coding</PageTitle>

<div class="ck-section-header mb-4">
    <span class="ck-section-prefix">// 01</span>
    <h2 class="ck-section-title">@L["Practice_Title"]</h2>
    <div class="ck-section-line"></div>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger dusk-glass-panel border-danger shadow-sm mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @_errorMessage
    </div>
}

@if (tasks == null)
{
    <p><em>@L["Loading"]</em></p>
}
else if (tasks.Count == 0)
{
    <p>@L["Practice_NoTasks"]</p>
}
else
{
    <div class="row g-3">
        @foreach (var task in tasks)
        {
            <div class="col-md-6 col-lg-4">
                <div class="task-card ck-panel p-4 h-100 transition-all cursor-pointer @(selectedTask?.Id == task.Id ? "border-primary shadow-glow" : "")" @onclick="() => SelectTask(task)">
                    <h5 class="fw-bold text-white mb-2">@task.Title</h5>
                    <p class="text-secondary small mb-3 text-truncate">@task.Description</p>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge dusk-badge-info">@task.DifficultyLevel</span>
                        @foreach (var tag in task.Tags)
                        {
                            <span class="badge dusk-badge-secondary">@tag</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (selectedTask != null)
{
    <hr class="border-secondary opacity-25 my-5" />
    
    <div class="ck-panel p-4 mb-4">
        <h4 class="fw-bold text-white mb-4">@L["Practice_SubmitSolution"] <span class="text-primary">@selectedTask.Title</span></h4>
        
        <div class="mb-5 p-4 rounded-3 border-secondary border border-opacity-25" style="background: rgba(0,0,0,0.3); border-left: 4px solid var(--ck-primary) !important;">
            <p class="text-light mb-0" style="white-space: pre-wrap; font-size: 1.05rem; line-height: 1.6;">@selectedTask.Description</p>
        </div>
        
        <div class="row mb-4">
            <div class="col-md-4">
                <label class="form-label text-secondary small fw-semibold text-uppercase tracking-wider">@L["Practice_Language"]</label>
                <select class="form-select ck-input" @bind="selectedLanguage">
                    @foreach (var lang in Enum.GetNames(typeof(ProgrammingLanguage)))
                    {
                        <option value="@lang">@lang</option>
                    }
                </select>
            </div>
        </div>

        <label class="form-label text-secondary small fw-semibold text-uppercase tracking-wider">@L["Practice_YourSolution"]</label>
        <div class="editor-container overflow-hidden" style="height: 500px; width: 100%; position: relative; border: 1px solid rgba(255,255,255,0.1); background: var(--ck-bg);">
            <StandaloneCodeEditor @ref="_editor" ConstructionOptions="EditorConstructionOptions" CssClass="w-100 h-100 placeholder-glow" />

            @if (showSuccessBlink)
            {
                <div class="laser-scanner-overlay">
                    <div class="laser-bolt"></div>
                    <div class="hud-success-text">
                        <i class="bi bi-shield-check me-2"></i> SYNTAX VERIFIED
                    </div>
                </div>
            }
        </div>
    </div>
    
    @if (syntaxErrors?.Any() == true)
    {
        <div class="alert alert-warning mb-3">
            <h6 class="alert-heading">@L["Practice_SyntaxErrors"]</h6>
            <ul class="mb-0">
                @foreach (var error in syntaxErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (!string.IsNullOrEmpty(_namespaceWarning))
    {
        <div class="alert mb-3 ck-panel" style="border-left: 3px solid var(--ck-amber, #f59e0b); background: rgba(245,158,11,.08);">
            <i class="bi bi-exclamation-diamond-fill me-2" style="color: var(--ck-amber, #f59e0b);"></i>
            <span class="text-white-75">@((MarkupString)_namespaceWarning)</span>
        </div>
    }

    <div class="d-flex gap-3 mb-5 flex-wrap">
        <button class="btn dusk-btn-outline px-4 py-2" @onclick="CheckSyntax">
            <i class="bi bi-check2-circle me-2"></i> @L["Practice_CheckSyntax"]
        </button>
        <button class="btn dusk-btn-outline px-4 py-2" @onclick="AutoFormat" disabled="@(selectedLanguage != nameof(ProgrammingLanguage.CSharp))">
            <i class="bi bi-magic me-2"></i> @L["Practice_AutoFormat"]
        </button>
        <button class="btn btn-warning text-dark fw-bold px-4 py-2" @onclick="RequestLightbulbHint" disabled="@(selectedTask == null)">
            <i class="bi bi-lightbulb-fill me-2"></i> Socratic Hint 💡
        </button>
        <button class="btn btn-amber px-5 py-2 fw-bold ms-auto" @onclick="SubmitCode" disabled="@(isSubmitting)">
            @if (isSubmitting)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                @L["Submitting"]
            }
            else
            {
                <i class="bi bi-cloud-upload me-2"></i> @L["Submit"]
            }
        </button>
    </div>

    @if (submissionResult != null)
    {
        <hr />
        <h4>@L["Practice_Result"]</h4>
        <div class="alert @(submissionResult.Feedback?.IsSuccess == true ? "alert-success" : "alert-danger")">
            <strong>@L["Practice_Status"]</strong> @submissionResult.Submission?.Status<br />
            <strong>@L["Practice_Summary"]</strong> @submissionResult.Feedback?.Summary
        </div>

        @if (submissionResult.Feedback?.CompilationMessages?.Any() == true)
        {
            <h5>@L["Practice_Compilation"]</h5>
            <ul>
                @foreach (var msg in submissionResult.Feedback.CompilationMessages)
                {
                    <li>@msg</li>
                }
            </ul>
        }

        @if (submissionResult.Feedback?.TestMessages?.Any() == true)
        {
            <h5>@L["Practice_Tests"]</h5>
            <ul>
                @foreach (var msg in submissionResult.Feedback.TestMessages)
                {
                    <li>@msg</li>
                }
            </ul>
        }

        <DuskOfCoding.WebUi.Components.Shared.FeedbackWidget TaskId="@selectedTask!.Id" />
    }
}

<TutorTerminal @ref="tutorTerminal" TaskId="@selectedTask?.Id.ToString()" OnGetDraftCode="GetDraftCodeAsync" OnEvaluationReceived="RefreshSubmission" />

@code {
    private List<TaskDto>? tasks;
    private TaskDto? selectedTask;
    private StandaloneCodeEditor? _editor;
    private TutorTerminal? tutorTerminal;
    private string selectedLanguage = nameof(ProgrammingLanguage.CSharp);
    private bool isSubmitting;
    private SubmissionResultDto? submissionResult;
    private List<string>? syntaxErrors;
    private bool showSuccessBlink;
    private string? _errorMessage;
    private string? _namespaceWarning;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var result = await Api.GetTasksAsync();
            if (result.IsSuccess)
            {
                tasks = result.Value;
            }
            else
            {
                _errorMessage = result.ErrorMessage;
                tasks = new List<TaskDto>();
            }
            StateHasChanged();
        }
    }

    private async Task SelectTask(TaskDto task)
    {
        selectedTask = task;
        submissionResult = null;
        _namespaceWarning = null;
        if (_editor != null)
        {
            await _editor.SetValue(BuildStarterCode(task));
        }
    }

    private static string BuildStarterCode(TaskDto task)
    {
        var sutName = string.IsNullOrWhiteSpace(task.ExpectedClassName) ? "Solution" : task.ExpectedClassName;
        return string.IsNullOrWhiteSpace(task.Namespace)
            ? $"public class {sutName}\n{{\n    // Write your code here\n}}"
            : $"namespace {task.Namespace};\n\npublic class {sutName}\n{{\n    // Write your code here\n}}";
    }

    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            Language = "csharp",
            Value = selectedTask is not null ? BuildStarterCode(selectedTask) : "// Select a task to begin",
            Theme = "vs-dark",
            AutomaticLayout = true,
            Minimap = new EditorMinimapOptions { Enabled = false }
        };
    }

    private async Task CheckSyntax()
    {
        if (_editor == null) return;
        var sourceCode = await _editor.GetValue();
        if (string.IsNullOrWhiteSpace(sourceCode)) return;

        syntaxErrors = new List<string>();

        // We only support local syntax checks for C# in this POC
        if (selectedLanguage == nameof(ProgrammingLanguage.CSharp))
        {
            var syntaxTree = CSharpSyntaxTree.ParseText(sourceCode);
            var diagnostics = syntaxTree.GetDiagnostics()
                .Where(d => d.Severity == DiagnosticSeverity.Error)
                .Select(d => $"Line {d.Location.GetLineSpan().StartLinePosition.Line + 1}: {d.GetMessage()}")
                .ToList();
            
            if (diagnostics.Any())
            {
                syntaxErrors.AddRange(diagnostics);
            }
            else
            {
                showSuccessBlink = true;
                StateHasChanged();
                await Task.Delay(1800);  // Allow laser + HUD animation to finish
                showSuccessBlink = false;
            }
        }
    }

    private async Task AutoFormat()
    {
        if (_editor == null || selectedLanguage != nameof(ProgrammingLanguage.CSharp)) return;
        var sourceCode = await _editor.GetValue();
        if (string.IsNullOrWhiteSpace(sourceCode)) return;

        var syntaxTree = CSharpSyntaxTree.ParseText(sourceCode);
        var formattedNode = syntaxTree.GetRoot().NormalizeWhitespace();
        await _editor.SetValue(formattedNode.ToFullString());
    }

    private async Task SubmitCode()
    {
        if (selectedTask == null || _editor == null) return;
        var sourceCode = await _editor.GetValue();
        if (string.IsNullOrWhiteSpace(sourceCode)) return;

        // Namespace check: warn the student if namespace is expected but missing
        _namespaceWarning = null;
        if (!string.IsNullOrWhiteSpace(selectedTask.Namespace)
            && !sourceCode.Contains("namespace ", StringComparison.OrdinalIgnoreCase))
        {
            _namespaceWarning = string.Format(L["Practice_NamespaceWarning"].Value, selectedTask.Namespace);
        }

        isSubmitting = true;
        submissionResult = null;
        syntaxErrors = null;
        _errorMessage = null;
        try
        {
            var result = await Api.SubmitCodeAsync(selectedTask.Id, sourceCode, selectedLanguage, System.Globalization.CultureInfo.CurrentUICulture.Name);
            if (!result.IsSuccess)
            {
                submissionResult = new SubmissionResultDto
                {
                    Feedback = new FeedbackDto { IsSuccess = false, Summary = result.ErrorMessage ?? "Submission failed" }
                };
            }
            else
            {
                submissionResult = result.Value;
                // Subscribe TutorTerminal to receive real-time tutor feedback
                if (submissionResult?.Submission?.Id is Guid subId && tutorTerminal is not null)
                {
                    await tutorTerminal.SubscribeToSubmission(subId);
                }
            }
        }
        catch (Exception ex)
        {
            submissionResult = new SubmissionResultDto
            {
                Feedback = new FeedbackDto { IsSuccess = false, Summary = $"Error: {ex.Message}" }
            };
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task<string> GetDraftCodeAsync()
    {
        if (_editor == null) return string.Empty;
        return await _editor.GetValue();
    }

    private async Task RequestLightbulbHint()
    {
        if (selectedTask == null || _editor == null || tutorTerminal == null) return;
        var sourceCode = await _editor.GetValue();
        if (string.IsNullOrWhiteSpace(sourceCode)) return;
        await tutorTerminal.TriggerLightbulbHint(selectedTask.Id.ToString(), sourceCode, null);
    }

    private async Task RefreshSubmission(Guid submissionId)
    {
        if (selectedTask == null) return;
        
        var result = await Api.GetSubmissionByIdAsync(submissionId);
        if (result.IsSuccess)
        {
            submissionResult = result.Value;
            StateHasChanged();
        }
    }
}


