@page "/admin"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "admin")]
@inject DuskOfCoding.WebUi.Services.ApiClient Api

<PageTitle>Admin Dashboard — DuskOfCoding</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h2 class="display-6 fw-bold text-white mb-0">Platform Overview</h2>
        <p class="text-white-50 mb-0 mt-2">Aggregate analytics for all student submissions.</p>
    </div>
</div>

@if (_isLoading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger dusk-glass-panel border-danger shadow-sm mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @_errorMessage
    </div>
}
else if (_stats != null)
{
    <div class="row g-4">
        <!-- Metric Cards -->
        <div class="col-md-3">
            <div class="dusk-glass-panel p-4 h-100 text-center">
                <i class="bi bi-people display-4 text-info mb-3"></i>
                <h3 class="fw-bold text-white mb-1">@_stats.TotalStudents</h3>
                <span class="text-white-50 small text-uppercase fw-semibold">Active Students</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="dusk-glass-panel p-4 h-100 text-center">
                <i class="bi bi-list-task display-4 text-warning mb-3"></i>
                <h3 class="fw-bold text-white mb-1">@_stats.TotalTasks</h3>
                <span class="text-white-50 small text-uppercase fw-semibold">Available Tasks</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="dusk-glass-panel p-4 h-100 text-center">
                <i class="bi bi-hdd-network display-4 text-primary mb-3"></i>
                <h3 class="fw-bold text-white mb-1">@_stats.TotalSubmissions</h3>
                <span class="text-white-50 small text-uppercase fw-semibold">Total Submissions</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="dusk-glass-panel p-4 h-100 text-center">
                <i class="bi bi-bullseye display-4 text-success mb-3"></i>
                <h3 class="fw-bold text-white mb-1">@_stats.SuccessRate%</h3>
                <span class="text-white-50 small text-uppercase fw-semibold">Global Success Rate</span>
            </div>
        </div>
    </div>
    
    @if (_feedbackOverview != null && _feedbackOverview.Any())
    {
        <div class="mt-5 dusk-glass-panel p-4">
            <h4 class="text-white fw-bold mb-4">Task Feedback Analytics</h4>
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="text-uppercase small text-white-50">
                        <tr>
                            <th>Task</th>
                            <th class="text-center">Avg Rating</th>
                            <th class="text-center">Total Feedback</th>
                            <th class="text-end">Latest Activity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fb in _feedbackOverview)
                        {
                            <tr>
                                <td class="fw-semibold">@fb.TaskTitle</td>
                                <td class="text-center">
                                    <div class="d-flex align-items-center justify-content-center">
                                        <i class="bi bi-star-fill text-warning me-2"></i>
                                        <span class="fs-5 fw-bold">@fb.AverageRating.ToString("0.0")</span>
                                    </div>
                                </td>
                                <td class="text-center text-secondary">@fb.FeedbackCount responses</td>
                                <td class="text-end text-secondary small">@fb.LatestFeedbackDate.ToLocalTime().ToString("MMM dd, HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="mt-5 dusk-glass-panel p-5 text-center">
            <i class="bi bi-bar-chart-line display-1 text-secondary opacity-25 mb-4 d-block"></i>
            <h4 class="text-white">Detailed Analytics Coming Soon</h4>
            <p class="text-white-50 mb-0">Future phases will introduce interactive graphs and task-level breakdowns.</p>
        </div>
    }
}

@code {
    private bool _isLoading = true;
    private string? _errorMessage;
    private DuskOfCoding.WebUi.Services.ApiClient.AdminStatsDto? _stats;
    private List<DuskOfCoding.WebUi.Services.TaskFeedbackOverviewDto>? _feedbackOverview;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            var result = await Api.GetAdminStatsAsync();
            if (result.IsSuccess)
            {
                _stats = result.Value;
            }
            else
            {
                _errorMessage = result.ErrorMessage;
            }

            var feedbackResult = await Api.GetAdminFeedbackOverviewAsync();
            if (feedbackResult.IsSuccess)
            {
                _feedbackOverview = feedbackResult.Value;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load dashboard data: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
