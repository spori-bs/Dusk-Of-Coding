    @* ── 4. THE ABYSS ─────────────────────────────────────────── *@
    <section class="dossier-section dossier-reveal">
        <div class="section-header">
            <span class="section-prefix">@Loc["AbyssSectionPrefix"]</span>
            <h2 class="section-title">@Loc["AbyssSectionTitle"]</h2>
            <div class="section-line"></div>
        </div>

        <div class="abyss-intro">@Loc["AbyssIntro"]</div>

        <div class="incident-grid">

            <div class="incident-panel dossier-reveal">
                <div class="incident-header">@Loc["Incident001_Id"]</div>
                <div class="incident-line severity">@Loc["Incident001_Severity"]</div>
                <div class="incident-line muted">@Loc["Incident001_Component"]</div>
                <div class="incident-line muted">@Loc["Incident001_Symptom"]</div>
                <div class="incident-line muted">@Loc["Incident001_RootCause"]</div>
                <div class="incident-line resolution">@Loc["Incident001_Resolution"]</div>
                <div class="incident-line directive">@Loc["Incident001_Directive"]</div>
            </div>

            <div class="incident-panel dossier-reveal">
                <div class="incident-header">@Loc["Incident002_Id"]</div>
                <div class="incident-line severity">@Loc["Incident002_Severity"]</div>
                <div class="incident-line muted">@Loc["Incident002_Component"]</div>
                <div class="incident-line muted">@Loc["Incident002_Symptom"]</div>
                <div class="incident-line muted">@Loc["Incident002_RootCause"]</div>
                <div class="incident-line resolution">@Loc["Incident002_Resolution"]</div>
                <div class="incident-line directive">@Loc["Incident002_Directive"]</div>
            </div>

            <div class="incident-panel dossier-reveal">
                <div class="incident-header">@Loc["Incident003_Id"]</div>
                <div class="incident-line severity-medium">@Loc["Incident003_Severity"]</div>
                <div class="incident-line muted">@Loc["Incident003_Component"]</div>
                <div class="incident-line muted">@Loc["Incident003_Symptom"]</div>
                <div class="incident-line muted">@Loc["Incident003_RootCause"]</div>
                <div class="incident-line resolution">@Loc["Incident003_Resolution"]</div>
                <div class="incident-line directive">@Loc["Incident003_Directive"]</div>
            </div>

            <div class="incident-panel dossier-reveal" style="border-color: rgba(239, 68, 68, 0.4);">
                <div class="incident-header">@Loc["Incident004_Id"]</div>
                <div class="incident-line severity">@Loc["Incident004_Severity"]</div>
                <div class="incident-line muted">@Loc["Incident004_Component"]</div>
                <div class="incident-line muted">@Loc["Incident004_Symptom"]</div>
                <div class="incident-line muted">@Loc["Incident004_RootCause"]</div>
                <div class="incident-line resolution" style="color: #ef4444;">@Loc["Incident004_Resolution"]</div>
                <div class="incident-line directive">@Loc["Incident004_Directive"]</div>
            </div>

        </div>

        @* Recovery waveform — recolored to amber/red from Phase 16 *@
        <div class="recovery-graph">
            <svg viewBox="0 0 300 80" class="recovery-svg" aria-hidden="true">
                <g class="broken-seg">
                    <circle cx="30" cy="40" r="5" class="node-err" />
                    <circle cx="90" cy="40" r="5" class="node-err" />
                    <circle cx="150" cy="40" r="5" class="node-err" />
                    <path stroke-dasharray="6,4" class="edge-err" d="M35,40 L85,40" />
                    <path stroke-dasharray="6,4" class="edge-err" d="M95,40 L145,40" />
                </g>
                <g class="healed-seg">
                    <circle cx="180" cy="40" r="5" class="node-healed" />
                    <circle cx="240" cy="40" r="5" class="node-healed" />
                    <circle cx="300" cy="40" r="5" class="node-healed" />
                    <path class="edge-healed" d="M30,40 L185,40" />
                    <path class="edge-healed" d="M185,40 L245,40" />
                    <path class="edge-healed" d="M245,40 L300,40" />
                </g>
                <circle cx="162" cy="40" r="0" class="pulse-heal" />
            </svg>
        </div>
    </section>

    @* ── 5. RESOLUTION ────────────────────────────────────────── *@
