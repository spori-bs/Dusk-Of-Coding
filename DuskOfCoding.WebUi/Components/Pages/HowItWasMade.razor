                    </div>
                    <div class="log-entry">
                        <div class="log-connector"><span class="log-tick">├──</span></div>
                        <div class="log-body">
                            <div class="log-phase">@Loc["BuildLog_Phase10"]</div>
                            <div class="log-desc">@Loc["BuildLog_Phase10_Desc"]</div>
                        </div>
                    </div>
                    <div class="log-entry">
                        <div class="log-connector"><span class="log-tick">└──</span></div>
                        <div class="log-body">
                            <div class="log-phase">@Loc["BuildLog_Phase12"]</div>
                            <div class="log-desc">@Loc["BuildLog_Phase12_Desc"]</div>
                        </div>
                    </div>
                </div>
            </div>

            @* INTELLIGENCE *@
            <div class="log-group dossier-reveal">
                <div class="log-group-label">@Loc["BuildLogGroupIntelligence"]</div>
                <div class="log-entries">
                    <div class="log-entry">
                        <div class="log-connector"><span class="log-tick">├──</span></div>
