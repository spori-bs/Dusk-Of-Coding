            </div>

            @* IDENTITY *@
            <div class="log-group dossier-reveal">
                <div class="log-group-label">@Loc["BuildLogGroupIdentity"]</div>
                <div class="log-entries">
                    <div class="log-entry">
                        <div class="log-connector"><span class="log-tick">├──</span></div>
                        <div class="log-body">
                            <div class="log-phase">@Loc["BuildLog_Phase15"]</div>
                            <div class="log-desc">@Loc["BuildLog_Phase15_Desc"]</div>
                        </div>
                    </div>
                    <div class="log-entry">
                        <div class="log-connector"><span class="log-tick">├──</span></div>
                        <div class="log-body">
                            <div class="log-phase">@Loc["BuildLog_Phase17"]</div>
                            <div class="log-desc">@Loc["BuildLog_Phase17_Desc"]</div>
                        </div>
                    </div>
                    <div class="log-entry">
                        <div class="log-connector"><span class="log-tick">├──</span></div>
                        <div class="log-body">
                            <div class="log-phase">@Loc["BuildLog_Phase18"]</div>
                            <div class="log-desc">@Loc["BuildLog_Phase18_Desc"]</div>
                        </div>
                    </div>
                    <div class="log-entry">
                        <div class="log-connector"><span class="log-tick">├──</span></div>
