    @* ── 7. MANIFESTO FOOTER ──────────────────────────────────── *@
    <section class="dossier-section manifesto-section dossier-reveal">
        <div class="manifesto-inner">
            <div class="manifesto-prefix">@Loc["ManifestoSectionPrefix"]</div>
            <div class="manifesto-terminal">@Loc["ManifestoStatus"]</div>
            <p class="manifesto-line1">&ldquo;@Loc["ManifestoLine1"]&rdquo;</p>
