@page "/how-it-was-made"
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<HowItWasMade> Loc
@inject NavigationManager Nav

<PageTitle>@Loc["PageTitle"]</PageTitle>

<div class="dossier-root">

    @* ── 0. DOSSIER COVER ─────────────────────────────────────── *@
    <section class="dossier-cover" id="dossier-cover">

        @* PCB trace background *@
        <svg class="dossier-pcb" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            @for (int row = 1; row <= 12; row++)
            {
                <line x1="0" y1="@(row * 8.3)%" x2="100%" y2="@(row * 8.3)%" stroke="rgba(234,88,12,0.04)" stroke-width="1" />
            }
            @for (int col = 1; col <= 20; col++)
            {
                <line x1="@(col * 5)%" y1="0" x2="@(col * 5)%" y2="100%" stroke="rgba(234,88,12,0.04)" stroke-width="1" />
            }
        </svg>

        <div class="cover-corner cover-tl"></div>
        <div class="cover-corner cover-br"></div>

        <div class="cover-content">
            <div class="cover-classification">
                [ @Loc["DossierLabel"] ]
            </div>

            <div class="cover-docnum">@Loc["DocNumber"]</div>

            <h1 class="cover-title">@Loc["HeroTitle"]</h1>

            <p class="cover-abstract">@Loc["HeroAbstract"]</p>

            <div class="cover-meta-table">
                <div class="cover-meta-row">
                    <span class="meta-key">@Loc["MetaMethodology"]</span>
                    <span class="meta-sep">//</span>
                    <span class="meta-val">@Loc["MetaMethodologyValue"]</span>
                </div>
                <div class="cover-meta-row">
                    <span class="meta-key">@Loc["MetaStack"]</span>
                    <span class="meta-sep">//</span>
                    <span class="meta-val">@Loc["MetaStackValue"]</span>
                </div>
            </div>

            <div class="cover-status-strip">
                @Loc["HeroStatusStrip"]
            </div>
        </div>
    </section>

    @* ── 1. THE DIRECTIVE ─────────────────────────────────────── *@
    <section class="dossier-section dossier-reveal">
        <div class="section-header">
            <span class="section-prefix">@Loc["DirectiveSectionPrefix"]</span>
            <h2 class="section-title">@Loc["DirectiveSectionTitle"]</h2>
            <div class="section-line"></div>
        </div>

        <div class="directive-layout">
            <div class="directive-text">
                <p class="dossier-body">@Loc["DirectiveBody1"]</p>
                <p class="dossier-body">@Loc["DirectiveBody2"]</p>
            </div>

            <div class="directive-panel">
                <div class="instrument-static">
                    <div class="inst-header">@Loc["DirectiveMissionLabel"]</div>
                    <div class="inst-body">
                        <p class="inst-line">@Loc["DirectiveMissionLine1"]</p>
                        <p class="inst-line amber">@Loc["DirectiveMissionLine2"]</p>
                        <p class="inst-line amber">@Loc["DirectiveMissionLine3"]</p>
                    </div>
                    <div class="inst-footer">
                        <span class="status-dot pulse-dot"></span>
                        <span class="inst-status">@Loc["DirectiveMissionStatus"]</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ── 2. THE SYSTEM MAP ────────────────────────────────────── *@
    <section class="dossier-section dossier-reveal">
        <div class="section-header">
            <span class="section-prefix">@Loc["SystemMapSectionPrefix"]</span>
            <h2 class="section-title">@Loc["SystemMapSectionTitle"]</h2>
            <div class="section-line"></div>
        </div>

        <p class="dossier-body dossier-intro">@Loc["SystemMapIntro"]</p>

        @* Static instrument panels — always expanded, no JS needed *@
        <div class="sysmap-grid">
            <div class="instrument-static-panel">
                <div class="isp-header">
                    <i class="bi bi-cpu isp-icon"></i>
                    <span class="isp-title">Execution Sandbox</span>
                    <span class="isp-status">Roslyn Compiler — Active</span>
                    <span class="status-dot pulse-dot isp-dot"></span>
                </div>
                <div class="isp-body">
                    <p class="isp-desc">Student code compiled in an isolated AssemblyLoadContext with a 5-second execution timeout, memory caps, and full xUnit test runner — zero host contamination.</p>
                    <pre class="isp-readout"><code>services.AddSingleton&lt;ISecureCompilationService,
  SecureCompilationService&gt;();
services.AddSingleton&lt;ISandboxExecutionService,
  SandboxExecutionService&gt;();</code></pre>
                </div>
            </div>

            <div class="instrument-static-panel">
                <div class="isp-header">
                    <i class="bi bi-stars isp-icon"></i>
                    <span class="isp-title">Socratic Mentor</span>
                    <span class="isp-status">Gemini AI — Connected</span>
                    <span class="status-dot pulse-dot isp-dot"></span>
                </div>
                <div class="isp-body">
                    <p class="isp-desc">An AI tutor that never gives the answer. It interrogates the student's code via the Socratic method, delivered through a Polly-resilient RabbitMQ-backed pipeline with real-time SignalR streaming.</p>
                    <pre class="isp-readout"><code>IChatClient client = new AzureAIInferenceClient(...)
  .AsBuilder()
  .UseOpenTelemetry()
  .UseRetryPolicy(3)
  .Build();</code></pre>
                </div>
            </div>

            <div class="instrument-static-panel">
                <div class="isp-header">
                    <i class="bi bi-shield-lock isp-icon"></i>
                    <span class="isp-title">Identity Fortress</span>
                    <span class="isp-status">Keycloak IAM — Secured</span>
                    <span class="status-dot pulse-dot isp-dot"></span>
                </div>
                <div class="isp-body">
                    <p class="isp-desc">Centralized OIDC authentication via Keycloak. All tokens validated server-side. Session cookies stored in memory-backed ITicketStore to prevent HTTP 431 bloat.</p>
                    <pre class="isp-readout"><code>builder.Services.AddKeycloakWebAppAuthentication(
  builder.Configuration,
  realm: "dusk-of-coding",
  client: "dusk-web-ui");</code></pre>
                </div>
            </div>

            <div class="instrument-static-panel">
                <div class="isp-header">
                    <i class="bi bi-diagram-3 isp-icon"></i>
                    <span class="isp-title">Resilience Pipeline</span>
                    <span class="isp-status">Polly — 3 Strategies Active</span>
                    <span class="status-dot pulse-dot isp-dot"></span>
                </div>
                <div class="isp-body">
                    <p class="isp-desc">Every external call — AI inference, code execution, API requests — runs through a Polly CompositeStrategy: Retry (3×) → CircuitBreaker → Timeout. The system heals itself.</p>
                    <pre class="isp-readout"><code>pipeline.AddRetry(new RetryStrategyOptions
  { MaxRetryAttempts = 3 })
.AddCircuitBreaker(...)
.AddTimeout(TimeSpan.FromSeconds(30));</code></pre>
                </div>
            </div>
        </div>

        @* Architecture flow diagram — HTML flex, no SVG *@
        <div class="arch-flow">
            <div class="arch-node">Blazor WebUI</div>
            <i class="bi bi-arrow-right arch-arrow"></i>
            <div class="arch-node">WebAPI</div>
            <i class="bi bi-arrow-right arch-arrow"></i>
            <div class="arch-node">ExecutionAPI</div>
            <span class="arch-sep">//</span>
            <div class="arch-node muted">RabbitMQ</div>
            <i class="bi bi-arrow-right arch-arrow"></i>
            <div class="arch-node">TutorWorker</div>
            <i class="bi bi-arrow-right arch-arrow"></i>
            <div class="arch-node accent">Gemini AI</div>
        </div>
    </section>

    @* ── 3. BUILD LOG ─────────────────────────────────────────── *@
