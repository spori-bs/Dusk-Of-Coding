                        </div>
                    </div>
                    <div class="log-entry">
                        <div class="log-connector"><span class="log-tick">└──</span></div>
                        <div class="log-body">
                            <div class="log-phase">@Loc["BuildLog_Phase20"]</div>
                            <div class="log-desc">@Loc["BuildLog_Phase20_Desc"]</div>
                        </div>
                    </div>
                </div>
            </div>

            @* FINOMHANGOLÁS ÉS SKÁLÁZÁS *@
            <div class="log-group dossier-reveal">
                <div class="log-group-label">FINOMHANGOLÁS ÉS SKÁLÁZÁS</div>
