        <div class="section-header">
            <span class="section-prefix">@Loc["BuildLogSectionPrefix"]</span>
            <h2 class="section-title">@Loc["BuildLogSectionTitle"]</h2>
            <div class="section-line"></div>
        </div>

        <div class="build-log">

            @* FOUNDATION *@
