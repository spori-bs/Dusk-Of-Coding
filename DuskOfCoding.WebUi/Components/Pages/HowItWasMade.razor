                <div class="log-group-label">@Loc["BuildLogGroupFoundation"]</div>
                <div class="log-entries">
                    <div class="log-entry">
                        <div class="log-connector"><span class="log-tick">├──</span></div>
                        <div class="log-body">
                            <div class="log-phase">@Loc["BuildLog_Phase01"]</div>
                            <div class="log-desc">@Loc["BuildLog_Phase01_Desc"]</div>
                        </div>
                    </div>
                    <div class="log-entry">
                        <div class="log-connector"><span class="log-tick">├──</span></div>
                        <div class="log-body">
