@page "/access-denied"
@using DuskOfCoding.WebUi.Resources
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["AccessDenied_Title"] - Dusk of Coding</PageTitle>

<div class="d-flex align-items-center justify-content-center" style="min-height: 60vh;">
    <div class="text-center">
        <div class="mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock text-muted opacity-50">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
        </div>
        <h2 class="fw-bold text-white mb-3">@L["AccessDenied_Heading"]</h2>
        <p class="text-muted mb-4">@L["AccessDenied_Message"]</p>
        <a href="/" class="btn dusk-btn-outline">
            @L["AccessDenied_GoHome"]
        </a>
    </div>
</div>
