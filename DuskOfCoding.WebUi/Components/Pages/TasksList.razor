@page "/tasks"
@using DuskOfCoding.WebUi.Services
@using DuskOfCoding.WebUi.DTOs
@using DuskOfCoding.WebUi.Resources
@inject ApiClient Api
@inject IStringLocalizer<SharedResource> L
@using Microsoft.AspNetCore.Authorization
@using DuskOfCoding.Domain.Constants

@attribute [Authorize(Roles = AppRoles.Tutor + "," + AppRoles.Admin)]
@rendermode InteractiveServer

<PageTitle>@L["Tasks_Title"] | Dusk of Coding</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <div class="feature-icon-wrapper me-3" style="width: 50px; height: 50px; background: rgba(234, 88, 12, 0.2);">
            <i class="bi bi-list-task fs-4 text-warning"></i>
        </div>
        <h2 class="display-6 fw-bold text-white mb-0">@L["Tasks_Title"]</h2>
    </div>
    <a href="/tasks/create" class="btn btn-primary px-4 fw-bold shadow-sm">
        <i class="bi bi-plus-lg me-2"></i> @L["Tasks_CreateNew"]
    </a>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger dusk-glass-panel border-danger shadow-sm mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @_errorMessage
    </div>
}

@if (_tasks == null)
{
    <p><em>@L["Loading"]</em></p>
}
else if (!_tasks.Any())
{
    <p>@L["Tasks_NoTasks"]</p>
}
else
{
    <div class="dusk-glass-panel overflow-hidden">
        <div class="table-responsive">
            <table class="table table-borderless dusk-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4 py-3">@L["Tasks_ColTitle"]</th>
                        <th class="py-3">@L["Tasks_ColDifficulty"]</th>
                        <th class="py-3">@L["Tasks_ColTags"]</th>
                        <th class="text-end pe-4 py-3">@L["Tasks_ColActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in _tasks)
                    {
                        <tr class="align-middle border-bottom border-secondary border-opacity-25">
                            <td class="ps-4 py-3 fw-semibold text-white">@task.Title</td>
                            <td class="py-3">
                                <span class="badge dusk-badge-info">@task.DifficultyLevel</span>
                            </td>
                            <td class="py-3">
                                @foreach(var tag in task.Tags)
                                {
                                    <span class="badge dusk-badge-secondary me-1">@tag</span>
                                }
                            </td>
                            <td class="text-end pe-4 py-3">
                                <a href="/tasks/edit/@task.Id" class="btn btn-sm dusk-btn-outline me-2">
                                    <i class="bi bi-pencil-square"></i> @L["Edit"]
                                </a>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteTask(task.Id)">
                                    <i class="bi bi-trash3"></i> @L["Delete"]
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<TaskDto>? _tasks;
    private string? _errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadTasks();
            StateHasChanged();
        }
    }

    private async Task LoadTasks()
    {
        _errorMessage = null;
        var result = await Api.GetTasksAsync();
        if (result.IsSuccess)
        {
            _tasks = result.Value;
        }
        else
        {
            _errorMessage = result.ErrorMessage;
            _tasks = new List<TaskDto>();
        }
    }

    private async Task DeleteTask(Guid id)
    {
        var result = await Api.DeleteTaskAsync(id);
        if (!result.IsSuccess)
        {
            _errorMessage = result.ErrorMessage;
        }
        else
        {
            await LoadTasks();
        }
    }
}

<style>
    .dusk-table {
        color: var(--dusk-text-muted);
        --bs-table-bg: transparent;
        background-color: transparent;
    }
    .dusk-table thead {
        background: rgba(0, 0, 0, 0.4);
        border-bottom: 2px solid rgba(255, 255, 255, 0.05);
    }
    .dusk-table th {
        color: var(--dusk-text-primary);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
    }
    .dusk-table tbody tr {
        transition: background-color 0.2s ease;
    }
    .dusk-table tbody tr:hover {
        background-color: rgba(255, 255, 255, 0.02);
    }
    
    .dusk-badge-info {
        background: rgba(14, 165, 233, 0.15);
        color: #38bdf8;
        border: 1px solid rgba(14, 165, 233, 0.3);
    }
    
    .dusk-badge-secondary {
        background: rgba(148, 163, 184, 0.15);
        color: #94a3b8;
        border: 1px solid rgba(148, 163, 184, 0.3);
    }
</style>
