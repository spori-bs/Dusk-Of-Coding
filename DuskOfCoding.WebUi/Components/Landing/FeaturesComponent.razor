@using DuskOfCoding.WebUi.Resources
@inject IStringLocalizer<SharedResource> L

<section class="features-section py-5">
    <div class="container py-5">
        <div class="row g-5 align-items-start">

            <!-- Left: Diagnosis -->
            <div class="col-lg-6">
                <div class="ck-section-header mb-4">
                    <span class="ck-section-prefix">// THE PROBLEM</span>
                    <div class="ck-section-line"></div>
                </div>
                <h2 class="problem-headline mb-4">@L["Problem_Headline"]</h2>

                <div class="d-flex flex-column gap-3">
                    <div class="err-line">
                        <span class="err-tag">[ERR]</span>
                        <span>@L["Problem_Err1"]</span>
                    </div>
                    <div class="err-line">
                        <span class="err-tag">[ERR]</span>
                        <span>@L["Problem_Err2"]</span>
                    </div>
                    <div class="err-line">
                        <span class="err-tag">[ERR]</span>
                        <span>@L["Problem_Err3"]</span>
                    </div>
                </div>
            </div>

            <!-- Right: Stat panels -->
            <div class="col-lg-6">
                <div class="d-flex flex-column gap-3">
                    <div class="stat-panel">
                        <div class="stat-label">STAT // 01</div>
                        <div class="stat-desc">@L["Problem_Stat1_Desc"]</div>
                        <div class="stat-value">&gt; 70%</div>
                    </div>
                    <div class="stat-panel">
                        <div class="stat-label">STAT // 02</div>
                        <div class="stat-desc">@L["Problem_Stat2_Desc"]</div>
                        <div class="stat-value">&lt; 30%</div>
                    </div>
                    <div class="stat-panel">
                        <div class="stat-label">STAT // 03</div>
                        <div class="stat-desc">@L["Problem_Stat3_Desc"]</div>
                        <div class="stat-value">0</div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
