@using DuskOfCoding.WebUi.Resources
@inject IStringLocalizer<SharedResource> L

<section class="features-section py-5">
    <div class="container py-5">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold text-white mb-3">@L["Features_Heading"]</h2>
            <p class="lead dusk-text-muted mx-auto" style="max-width: 700px;">@L["Features_Subheading"]</p>
        </div>

        <div class="row g-4 mt-4">
            <div class="col-md-4">
                <div class="feature-card h-100 dusk-glass-panel p-5 text-center transition-all">
                    <div class="feature-icon-wrapper mb-4 mx-auto">
                        <i class="bi bi-shield-check display-5 text-primary"></i>
                    </div>
                    <h4 class="fw-bold text-white mb-3">@L["Features_Sandbox_Title"]</h4>
                    <p class="dusk-text-muted mb-0">@L["Features_Sandbox_Desc"]</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card h-100 dusk-glass-panel p-5 text-center transition-all" style="transform: translateY(-20px);">
                    <div class="feature-icon-wrapper mb-4 mx-auto">
                        <i class="bi bi-code-square display-5 text-warning"></i>
                    </div>
                    <h4 class="fw-bold text-white mb-3">@L["Features_Testing_Title"]</h4>
                    <p class="dusk-text-muted mb-0">@L["Features_Testing_Desc"]</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card h-100 dusk-glass-panel p-5 text-center transition-all">
                    <div class="feature-icon-wrapper mb-4 mx-auto">
                        <i class="bi bi-cpu display-5 text-danger"></i>
                    </div>
                    <h4 class="fw-bold text-white mb-3">@L["Features_AI_Title"]</h4>
                    <p class="dusk-text-muted mb-0">@L["Features_AI_Desc"]</p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .features-section {
        background-color: var(--dusk-bg-dark);
        position: relative;
    }
    
    .dusk-text-muted {
        color: var(--dusk-text-muted);
    }
    
    .feature-card {
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        border-bottom: 1px solid rgba(0, 0, 0, 0.5);
    }
    
    .feature-card:hover {
        transform: translateY(-10px) !important;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 20px rgba(124, 58, 237, 0.15);
        border-color: rgba(124, 58, 237, 0.3);
    }
    
    .feature-icon-wrapper {
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.03);
        box-shadow: inset 0 2px 10px rgba(255, 255, 255, 0.05);
    }
    
    .transition-all {
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
</style>
