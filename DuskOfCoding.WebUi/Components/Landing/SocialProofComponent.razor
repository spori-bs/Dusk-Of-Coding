@using DuskOfCoding.WebUi.Resources
@inject IStringLocalizer<SharedResource> L

<section class="social-proof-section py-5 bg-white">
    <div class="container text-center">
        <!-- Statistics / Features -->
        <h2 class="fw-bold mb-4">@L["Social_Heading"]</h2>
        <p class="text-muted mb-5">@L["Social_Subheading"]</p>

        <!-- Tech Stack Logos (Placeholders mapping to README tech) -->
        <p class="text-muted mb-4 fw-bold text-uppercase">@L["Social_PoweredBy"]</p>
        <div class="d-flex justify-content-center flex-wrap gap-4 opacity-50 mb-5">
            <h4 class="m-0">.NET 10</h4>
            <h4 class="m-0">.NET Aspire</h4>
            <h4 class="m-0">Blazor Server</h4>
            <h4 class="m-0">EF Core</h4>
            <h4 class="m-0">Roslyn</h4>
            <h4 class="m-0">Docker</h4>
        </div>

        <!-- Quote -->
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <blockquote class="blockquote border-0 fs-4 fst-italic text-dark">
                    @L["Social_Quote"]
                </blockquote>
                <figcaption class="blockquote-footer mt-3 fs-6">
                    <cite title="Source Title">@L["Social_QuoteSource"]</cite>
                </figcaption>
            </div>
        </div>
    </div>
</section>
