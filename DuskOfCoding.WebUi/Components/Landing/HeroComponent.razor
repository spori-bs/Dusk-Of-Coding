@using DuskOfCoding.WebUi.Resources
@inject IStringLocalizer<SharedResource> L

<section class="hero-section">
    <!-- PCB Grid Background — static, CSS-animated stroke-opacity -->
    <svg class="hero-pcb" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- Horizontal lines -->
        <line x1="0" y1="20%" x2="100%" y2="20%" />
        <line x1="0" y1="40%" x2="100%" y2="40%" />
        <line x1="0" y1="60%" x2="100%" y2="60%" />
        <line x1="0" y1="80%" x2="100%" y2="80%" />
        <!-- Vertical lines -->
        <line x1="10%" y1="0" x2="10%" y2="100%" />
        <line x1="25%" y1="0" x2="25%" y2="100%" />
        <line x1="50%" y1="0" x2="50%" y2="100%" />
        <line x1="75%" y1="0" x2="75%" y2="100%" />
        <line x1="90%" y1="0" x2="90%" y2="100%" />
        <!-- Junction dots -->
        <circle cx="10%" cy="20%" r="3" />
        <circle cx="25%" cy="40%" r="3" />
        <circle cx="50%" cy="20%" r="3" />
        <circle cx="75%" cy="60%" r="3" />
        <circle cx="90%" cy="40%" r="3" />
        <circle cx="10%" cy="60%" r="3" />
        <circle cx="50%" cy="80%" r="3" />
        <circle cx="25%" cy="80%" r="3" />
        <circle cx="75%" cy="20%" r="3" />
    </svg>

    <div class="hero-content">
        <!-- Classification label -->
        <div class="hero-label">
            <span class="ck-status-dot me-2"></span>
            DUSK OF CODING // PLATFORM v1.0
        </div>

        <!-- H1 -->
        <h1 class="hero-headline">
            @L["Hero_Headline_L1"]<br />
            @L["Hero_Headline_L2"]<br />
            @L["Hero_Headline_L3"]
        </h1>

        <!-- Sub statement — de-blur on hover -->
        <div class="hero-sub-wrapper">
            <p class="hero-sub">@L["Hero_Sub"]</p>
        </div>

        <!-- CTAs -->
        <div class="hero-ctas">
            <AuthorizeView>
                <Authorized>
                    <a href="/practice" class="btn btn-amber">@L["Hero_CTA_Primary"]</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/register?returnUrl=%2Fpractice" class="btn btn-amber">@L["Hero_CTA_Primary"]</a>
                </NotAuthorized>
            </AuthorizeView>
            <a href="/how-it-was-made" class="btn btn-amber hero-cta-secondary">@L["Hero_CTA_Secondary"]</a>
        </div>

        <!-- Status bar -->
        <div class="hero-status-bar">
            <span>SANDBOX // Roslyn Compiler</span>
            <span>MENTOR // Gemini AI</span>
            <span>IAM // Keycloak</span>
            <span>RESILIENCE // Polly</span>
        </div>
    </div>
</section>
