@using DuskOfCoding.WebUi.Resources
@inject IStringLocalizer<SharedResource> L

<section id="demo" class="media-demo-section py-5 text-center">
    <div class="container py-5">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold text-white mb-4">@L["MediaDemo_Title"]</h2>
            <p class="lead dusk-text-muted mx-auto mb-5" style="max-width: 700px;">@L["MediaDemo_Subtitle"]</p>
        </div>
        
        <div class="row justify-content-center">
            <div class="col-lg-9 relative z-1">
                <!-- Premium Video Frame -->
                <div class="video-container dusk-glass-panel p-2">
                    <div class="ratio ratio-16x9 bg-black rounded shadow position-relative overflow-hidden">
                        <!-- Abstract placeholder grid pattern -->
                        <div class="video-placeholder-grid"></div>
                        <div class="d-flex flex-column align-items-center justify-content-center h-100 position-relative z-10 text-white">
                            <button class="btn btn-play shadow-lg stretched-link">
                                <i class="bi bi-play-fill fs-1"></i>
                            </button>
                            <span class="mt-3 text-secondary small fw-semibold tracking-wider text-uppercase">Play Demo</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .media-demo-section {
        background: linear-gradient(180deg, var(--dusk-bg-dark) 0%, var(--dusk-bg-panel) 100%);
        position: relative;
    }
    
    .video-container {
        border-radius: 20px;
        box-shadow: 0 30px 60px rgba(0,0,0,0.6), 0 0 100px rgba(76, 29, 149, 0.2);
        transform: translateY(0);
        transition: transform 0.4s ease;
    }
    
    .video-container:hover {
        transform: translateY(-5px);
    }

    .btn-play {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: rgba(234, 88, 12, 0.9);
        color: white;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        padding-left: 6px; /* Balance the triangle optical center */
        transition: all 0.3s ease;
        box-shadow: 0 0 0 0 rgba(234, 88, 12, 0.7);
        animation: pulsePlay 2s infinite;
    }
    
    .btn-play:hover {
        background: var(--dusk-orange-warm);
        color: white;
        transform: scale(1.1);
        animation: none;
        box-shadow: 0 10px 25px rgba(234, 88, 12, 0.5);
    }
    
    @@keyframes pulsePlay {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(234, 88, 12, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 20px rgba(234, 88, 12, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(234, 88, 12, 0); }
    }
    
    .video-placeholder-grid {
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
                          linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
        background-size: 30px 30px;
        opacity: 0.5;
    }
</style>
