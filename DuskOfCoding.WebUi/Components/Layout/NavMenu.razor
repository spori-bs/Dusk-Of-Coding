@using DuskOfCoding.WebUi.Resources
@inject IStringLocalizer<SharedResource> L

<nav class="d-flex align-items-center">
    <div class="nav-item me-3">
        <NavLink class="nav-link text-dark fw-semibold" href="" Match="NavLinkMatch.All">
            <i class="bi bi-house-door me-1"></i> @L["Nav_Home"]
        </NavLink>
    </div>

    <div class="nav-item me-3">
        <NavLink class="nav-link text-dark fw-semibold" href="practice">
            <i class="bi bi-code-slash me-1"></i> @L["Nav_Practice"]
        </NavLink>
    </div>

    <div class="nav-item me-3">
        <NavLink class="nav-link text-dark fw-semibold" href="tasks">
            <i class="bi bi-list-task me-1"></i> @L["Nav_ManageTasks"]
        </NavLink>
    </div>
</nav>
