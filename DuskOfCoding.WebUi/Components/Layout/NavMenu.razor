@using DuskOfCoding.WebUi.Resources
@inject IStringLocalizer<SharedResource> L

<nav class="d-flex align-items-center">
    <div class="nav-item me-3">
        <NavLink class="nav-link dusk-nav-link fw-semibold" href="" Match="NavLinkMatch.All">
            <i class="bi bi-house-door me-1"></i> @L["Nav_Home"]
        </NavLink>
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="nav-item me-3">
                <NavLink class="nav-link dusk-nav-link fw-semibold" href="practice">
                    <i class="bi bi-code-slash me-1"></i> @L["Nav_Practice"]
                </NavLink>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="nav-item me-3">
                <NavLink class="nav-link dusk-nav-link fw-semibold" href="login">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Login
                </NavLink>
            </div>
        </NotAuthorized>
    </AuthorizeView>

    <AuthorizeView Roles="admin">
        <Authorized>
            <div class="nav-item me-3">
                <NavLink class="nav-link dusk-nav-link fw-semibold text-warning" href="admin">
                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link dusk-nav-link fw-semibold" href="tasks">
                    <i class="bi bi-list-task me-1"></i> @L["Nav_ManageTasks"]
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>
    
    <div class="ms-4 border-start border-secondary opacity-50 ps-4">
        <LoginDisplay />
    </div>
</nav>

<style>
    .dusk-nav-link {
        color: var(--dusk-text-muted) !important;
        position: relative;
        padding-bottom: 2px;
        transition: color 0.3s ease;
    }
    .dusk-nav-link:hover, .dusk-nav-link.active {
        color: var(--dusk-text-primary) !important;
    }
    .dusk-nav-link::after {
        content: '';
        position: absolute;
        width: 0;
        height: 2px;
        bottom: 0;
        left: 50%;
        background-color: var(--dusk-orange-glow);
        transition: all 0.3s ease;
        transform: translateX(-50%);
        box-shadow: 0 0 8px var(--dusk-orange-glow);
    }
    .dusk-nav-link:hover::after, .dusk-nav-link.active::after {
        width: 80%;
    }
</style>
