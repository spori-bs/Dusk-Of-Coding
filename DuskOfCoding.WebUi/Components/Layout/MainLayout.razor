@inherits LayoutComponentBase
@using DuskOfCoding.WebUi.Resources
@inject IStringLocalizer<SharedResource> L

<div class="app-page-wrapper">
    <header class="app-header">
        <div class="d-flex align-items-center">
            <a href="/" class="app-logo me-4">@L["AppTitle"]</a>
            <NavMenu />
        </div>
        <div>
            <LanguageSelector />
        </div>
    </header>

    <main class="app-main">
        <div class="container py-4" style="min-height: calc(100vh - 140px);">
            @Body
        </div>
    </main>

    <footer class="app-footer">
        <div class="container text-center">
            <span class="opacity-75">&copy; @DateTime.Now.Year @L["Footer_Rights"]</span>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @L["Error_Unhandled"]
    <a href="." class="reload">@L["Error_Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    .app-page-wrapper {
        font-family: 'Outfit', sans-serif;
        background-color: var(--dusk-bg-dark);
        color: var(--dusk-text-primary);
    }
    .app-header {
        padding: 0 2rem;
        height: 70px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: rgba(15, 23, 42, 0.85);
        backdrop-filter: blur(10px);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        position: sticky;
        top: 0;
        z-index: 1000;
        border-bottom: 2px solid var(--dusk-orange-glow);
    }
    .app-logo {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--dusk-text-primary);
        text-decoration: none;
        letter-spacing: 0.5px;
        transition: text-shadow 0.3s ease;
    }
    .app-logo:hover {
        text-shadow: 0 0 10px rgba(255,255,255,0.3);
        color: white;
    }
    .app-main {
        min-height: calc(100vh - 140px);
    }
    .app-footer {
        height: 70px;
        padding: 2rem;
        background: rgba(9, 9, 11, 0.95);
        border-top: 1px solid rgba(255,255,255,0.05);
        color: var(--dusk-text-muted);
        font-size: 0.9rem;
    }
</style>
