@inherits LayoutComponentBase
@using DuskOfCoding.WebUi.Resources
@inject IStringLocalizer<SharedResource> L

<div class="app-page-wrapper">
    <header class="app-header">
        <div class="d-flex align-items-center">
            <a href="/" class="app-logo me-4"><span class="logo-prefix">&gt; </span>@L["AppTitle"]</a>
            <NavMenu />
        </div>
        <div class="d-flex align-items-center gap-3">
            <LoginDisplay />
            <LanguageSelector />
        </div>
    </header>

    <main class="app-main">
        <div class="container py-4" style="min-height: calc(100vh - 140px);">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="exception">
                    <CustomErrorContent Exception="exception" OnRecover="Recover" />
                </ErrorContent>
            </ErrorBoundary>
        </div>
    </main>

    @code {
        private ErrorBoundary? _errorBoundary;

        private void Recover()
        {
            _errorBoundary?.Recover();
        }
    }


    <footer class="app-footer">
        <div class="container text-center">
            <span class="opacity-75">&copy; @DateTime.Now.Year @L["Footer_Rights"]</span>
        </div>
    </footer>
</div>

<ToastContainer />

<div id="blazor-error-ui" data-nosnippet>
    @L["Error_Unhandled"]
    <a href="." class="reload">@L["Error_Reload"]</a>
    <span class="dismiss">🗙</span>
</div>


