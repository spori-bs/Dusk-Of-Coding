@inherits LayoutComponentBase
@using DuskOfCoding.WebUi.Resources
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager NavigationManager

<div class="landing-page-wrapper">
    <header class="landing-header">
        <a href="" class="landing-logo"><span class="logo-prefix">&gt; </span>@L["AppTitle"]</a>
        <div class="d-flex align-items-center gap-3">
            <AuthorizeView>
                <Authorized>
                    <a href="/practice" class="landing-nav-link">@L["Landing_Practice"]</a>
                    <AuthorizeView Roles="@($"{AppRoles.Tutor},{AppRoles.Admin}")">
                        <Authorized Context="tutorCtx">
                            <a href="/tasks" class="landing-nav-link">@L["Landing_ManageTasks"]</a>
                        </Authorized>
                    </AuthorizeView>
                    <a href="/cockpit" class="landing-nav-link">Cockpit</a>
                </Authorized>
            </AuthorizeView>
            <a href="/how-it-was-made" class="landing-nav-link">@L["Hero_HowItWasMade"]</a>
            <AuthorizeView>
                <Authorized>
                    <AuthorizeView Roles="@($"{AppRoles.Tutor},{AppRoles.Admin}")">
                        <Authorized Context="tutorCtx2">
                            <span class="landing-role-badge">
                                <i class="bi bi-shield-lock-fill me-1"></i>@L["Auth_AdminBadge"]
                            </span>
                        </Authorized>
                    </AuthorizeView>
                    <form action="logout" method="post" class="m-0">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-amber btn-sm">@L["Auth_Logout"]</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a href="login?returnUrl=@Uri.EscapeDataString(NavigationManager.ToBaseRelativePath(NavigationManager.Uri))" class="btn btn-amber btn-sm">@L["Auth_Login"]</a>
                    <a href="/register" class="btn btn-amber btn-sm">@L["Landing_GetStarted"]</a>
                </NotAuthorized>
            </AuthorizeView>
            <LanguageSelector />
        </div>
    </header>

    <main class="landing-main">
        @Body
    </main>

    <footer class="landing-footer">
        <div class="container text-center">
            <span class="footer-copy">// DUSK OF CODING — &copy; @DateTime.Now.Year @L["Footer_Rights"]</span>
        </div>
    </footer>
</div>
