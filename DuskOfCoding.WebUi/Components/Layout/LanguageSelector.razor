@using DuskOfCoding.WebUi.Resources
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav

<div class="language-selector">
    <select class="form-select form-select-sm" @onchange="OnLanguageChanged">
        <option value="hu" selected="@(currentCulture == "hu")">🇭🇺 @L["Language_Hungarian"]</option>
        <option value="en" selected="@(currentCulture == "en")">🇬🇧 @L["Language_English"]</option>
    </select>
</div>

@code {
    private string currentCulture = "hu";

    protected override void OnInitialized()
    {
        currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    }

    private void OnLanguageChanged(ChangeEventArgs e)
    {
        var culture = e.Value?.ToString() ?? "hu";
        var uri = new Uri(Nav.Uri).PathAndQuery;
        Nav.NavigateTo($"/Culture/Set?culture={culture}&redirectUri={uri}", forceLoad: true);
    }
}

<style>
    .language-selector .form-select {
        width: auto;
        min-width: 130px;
        font-size: 0.85rem;
        background-color: rgba(255, 255, 255, 0.05); /* subtle transparency */
        color: var(--dusk-text-primary);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        transition: all 0.3s ease;
    }
    .language-selector .form-select:hover, .language-selector .form-select:focus {
        background-color: rgba(255, 255, 255, 0.1);
        border-color: var(--dusk-purple-light);
        box-shadow: 0 0 10px rgba(124, 58, 237, 0.3);
    }
    .language-selector .form-select option {
        background-color: var(--dusk-bg-panel);
        color: var(--dusk-text-primary);
    }
</style>
