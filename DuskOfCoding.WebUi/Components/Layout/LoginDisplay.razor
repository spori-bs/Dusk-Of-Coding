@using Microsoft.AspNetCore.Components.Authorization
@using DuskOfCoding.WebUi.Resources
@using Microsoft.Extensions.Localization
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L

<AuthorizeView>
    <Authorized>
        <div class="position-relative" @onclick:stopPropagation="true"
             tabindex="-1"
             @onfocusout="OnFocusOut"
             style="outline:none;">
            <button class="btn btn-sm dusk-btn-outline d-flex align-items-center gap-2"
                    type="button"
                    @onclick="ToggleDropdown"
                    id="userProfileDropdown">
                <i class="bi bi-person-circle"></i>
                <span class="d-none d-sm-inline">@context.User.Identity?.Name</span>
                @if (context.User.IsInRole(AppRoles.Admin))
                {
                    <span class="badge bg-danger ms-1" style="font-size:0.65rem;">@L["Auth_AdminBadge"]</span>
                }
                else if (context.User.IsInRole(AppRoles.Tutor))
                {
                    <span class="badge bg-warning text-dark ms-1" style="font-size:0.65rem;">@L["Auth_TutorBadge"]</span>
                }
                else
                {
                    <span class="badge bg-info text-dark ms-1" style="font-size:0.65rem;">@L["Auth_StudentBadge"]</span>
                }
                <i class="bi bi-chevron-down" style="font-size:0.7rem;"></i>
            </button>

            @if (_dropdownOpen)
            {
                <div class="position-absolute end-0 mt-1 py-1"
                     style="background:var(--ck-surface); border:1px solid var(--ck-border-dim); border-radius:2px; min-width:220px; z-index:1050; box-shadow:var(--ck-shadow);">

                    <div class="px-3 py-2 text-secondary small border-bottom" style="border-color:var(--ck-border-dim)!important;">
                        <div><i class="bi bi-person-fill me-2"></i>@context.User.Identity?.Name</div>
                        @if (!string.IsNullOrEmpty(context.User.FindFirst("email")?.Value))
                        {
                            <div class="mt-1" style="font-size:0.78rem; opacity:0.7;">
                                <i class="bi bi-envelope me-2"></i>@context.User.FindFirst("email")?.Value
                            </div>
                        }
                    </div>

                    <div class="px-3 py-2 border-bottom" style="border-color:var(--ck-border-dim)!important;">
                        @if (context.User.IsInRole(AppRoles.Admin))
                        {
                            <span class="badge bg-danger px-2 py-1"><i class="bi bi-shield-lock-fill me-1"></i>@L["Auth_AdminBadge"]</span>
                        }
                        else if (context.User.IsInRole(AppRoles.Tutor))
                        {
                            <span class="badge bg-warning text-dark px-2 py-1"><i class="bi bi-mortarboard-fill me-1"></i>@L["Auth_TutorBadge"]</span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark px-2 py-1"><i class="bi bi-person-fill me-1"></i>@L["Auth_StudentBadge"]</span>
                        }
                    </div>

                    <div class="px-2 py-1">
                        <form action="logout" method="post" class="m-0">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-sm w-100 text-danger text-start px-2 py-1"
                                    style="background:transparent; border:none;">
                                <i class="bi bi-box-arrow-right me-2"></i>@L["Auth_Logout"]
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="d-flex align-items-center me-3">
            <a href="login?returnUrl=@Uri.EscapeDataString(NavigationManager.ToBaseRelativePath(NavigationManager.Uri))"
               data-enhance-nav="false"
               class="btn btn-sm btn-amber px-3 fw-semibold">
                <i class="bi bi-box-arrow-in-right me-1"></i>@L["Auth_Login"]
            </a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _dropdownOpen = false;

    private void ToggleDropdown() => _dropdownOpen = !_dropdownOpen;

    private async Task OnFocusOut()
    {
        // Brief delay so inner button clicks (e.g. logout submit) fire before we close
        await Task.Delay(150);
        _dropdownOpen = false;
    }
}
