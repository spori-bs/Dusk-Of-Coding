@using Microsoft.AspNetCore.Components.Authorization
@using DuskOfCoding.WebUi.Resources
@using Microsoft.Extensions.Localization
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L

<AuthorizeView>
    <Authorized>
        <div class="d-flex align-items-center me-3">
            <span class="text-white me-3 d-none d-md-inline" style="font-size: 0.9rem;">
                <i class="bi bi-person-circle me-1"></i> @context.User.Identity?.Name
            </span>
            @if (context.User.IsInRole("admin"))
            {
                <span class="badge bg-warning text-dark me-2 px-2 py-1" style="font-size: 0.75rem;">
                    <i class="bi bi-shield-lock-fill me-1"></i>@L["Auth_AdminBadge"]
                </span>
            }
            <form action="logout" method="post" class="m-0">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-sm dusk-btn-outline">@L["Auth_Logout"]</button>
            </form>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="d-flex align-items-center me-3">
            <a href="login?returnUrl=@Uri.EscapeDataString(NavigationManager.ToBaseRelativePath(NavigationManager.Uri))" class="btn btn-sm btn-primary px-3 fw-semibold shadow-sm">@L["Auth_Login"]</a>
        </div>
    </NotAuthorized>
</AuthorizeView>
