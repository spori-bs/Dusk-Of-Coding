@page "/practice"
@using PracticePlatform.WebUi.Services
@using PracticePlatform.WebUi.Resources
@using PracticePlatform.Domain.Enums
@using Microsoft.CodeAnalysis
@using Microsoft.CodeAnalysis.CSharp
@inject ApiClient Api
@inject IStringLocalizer<SharedResource> L
@rendermode InteractiveServer

<PageTitle>@L["Practice_Title"]</PageTitle>

<h1>@L["Practice_Title"]</h1>

@if (tasks == null)
{
    <p><em>@L["Loading"]</em></p>
}
else if (tasks.Count == 0)
{
    <p>@L["Practice_NoTasks"]</p>
}
else
{
    <div class="task-list">
        @foreach (var task in tasks)
        {
            <div class="card mb-3 @(selectedTask?.Id == task.Id ? "border-primary" : "")" @onclick="() => SelectTask(task)">
                <div class="card-body">
                    <h5 class="card-title">@task.Title</h5>
                    <p class="card-text">@task.Description</p>
                    <span class="badge bg-info">@task.DifficultyLevel</span>
                    @foreach (var tag in task.Tags)
                    {
                        <span class="badge bg-secondary ms-1">@tag</span>
                    }
                </div>
            </div>
        }
    </div>
}

@if (selectedTask != null)
{
    <hr />
    <h3>@L["Practice_SubmitSolution"]@selectedTask.Title</h3>
    <div class="mb-3">
        <label class="form-label">@L["Practice_Language"]</label>
        <select class="form-select mb-3" @bind="selectedLanguage">
            @foreach (var lang in Enum.GetNames(typeof(ProgrammingLanguage)))
            {
                <option value="@lang">@lang</option>
            }
        </select>

        <label class="form-label">@L["Practice_YourSolution"]</label>
        <div class="border rounded @(showSuccessBlink ? "border-success-blink" : "")" style="height: 400px; width: 100%; position: relative;">
            <StandaloneCodeEditor @ref="_editor" ConstructionOptions="EditorConstructionOptions" CssClass="w-100 h-100 placeholder-glow" />
        </div>
    </div>
    
    @if (syntaxErrors?.Any() == true)
    {
        <div class="alert alert-warning mb-3">
            <h6 class="alert-heading">@L["Practice_SyntaxErrors"]</h6>
            <ul class="mb-0">
                @foreach (var error in syntaxErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <button class="btn btn-secondary me-2" @onclick="CheckSyntax">
        @L["Practice_CheckSyntax"]
    </button>
    <button class="btn btn-outline-secondary me-2" @onclick="AutoFormat" disabled="@(selectedLanguage != nameof(ProgrammingLanguage.CSharp))">
        @L["Practice_AutoFormat"]
    </button>
    <button class="btn btn-primary" @onclick="SubmitCode" disabled="@(isSubmitting)">
        @(isSubmitting ? L["Submitting"] : L["Submit"])
    </button>

    @if (submissionResult != null)
    {
        <hr />
        <h4>@L["Practice_Result"]</h4>
        <div class="alert @(submissionResult.Feedback?.IsSuccess == true ? "alert-success" : "alert-danger")">
            <strong>@L["Practice_Status"]</strong> @submissionResult.Submission?.Status<br />
            <strong>@L["Practice_Summary"]</strong> @submissionResult.Feedback?.Summary
        </div>

        @if (submissionResult.Feedback?.CompilationMessages?.Any() == true)
        {
            <h5>@L["Practice_Compilation"]</h5>
            <ul>
                @foreach (var msg in submissionResult.Feedback.CompilationMessages)
                {
                    <li>@msg</li>
                }
            </ul>
        }

        @if (submissionResult.Feedback?.TestMessages?.Any() == true)
        {
            <h5>@L["Practice_Tests"]</h5>
            <ul>
                @foreach (var msg in submissionResult.Feedback.TestMessages)
                {
                    <li>@msg</li>
                }
            </ul>
        }

        @if (!string.IsNullOrEmpty(submissionResult.Feedback?.AiReviewRemarks))
        {
            <h5>@L["Practice_AIReview"]</h5>
            <p>@submissionResult.Feedback.AiReviewRemarks</p>
        }
    }
}

<TutorTerminal @ref="tutorTerminal" />

@code {
    private List<TaskDto>? tasks;
    private TaskDto? selectedTask;
    private StandaloneCodeEditor? _editor;
    private TutorTerminal? tutorTerminal;
    private string selectedLanguage = nameof(ProgrammingLanguage.CSharp);
    private bool isSubmitting;
    private SubmissionResultDto? submissionResult;
    private List<string>? syntaxErrors;
    private bool showSuccessBlink;

    protected override async Task OnInitializedAsync()
    {
        tasks = await Api.GetTasksAsync();
    }

    private async Task SelectTask(TaskDto task)
    {
        selectedTask = task;
        submissionResult = null;
        if (_editor != null)
        {
            await _editor.SetValue("");
        }
    }

    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            Language = "csharp",
            Value = "public class Solution\n{\n    // Write your code here\n}",
            Theme = "vs",
            AutomaticLayout = true,
            Minimap = new EditorMinimapOptions { Enabled = false }
        };
    }

    private async Task CheckSyntax()
    {
        if (_editor == null) return;
        var sourceCode = await _editor.GetValue();
        if (string.IsNullOrWhiteSpace(sourceCode)) return;

        syntaxErrors = new List<string>();

        // We only support local syntax checks for C# in this POC
        if (selectedLanguage == nameof(ProgrammingLanguage.CSharp))
        {
            var syntaxTree = CSharpSyntaxTree.ParseText(sourceCode);
            var diagnostics = syntaxTree.GetDiagnostics()
                .Where(d => d.Severity == DiagnosticSeverity.Error)
                .Select(d => $"Line {d.Location.GetLineSpan().StartLinePosition.Line + 1}: {d.GetMessage()}")
                .ToList();
            
            if (diagnostics.Any())
            {
                syntaxErrors.AddRange(diagnostics);
            }
            else
            {
                showSuccessBlink = true;
                StateHasChanged();
                await Task.Delay(1000);
                showSuccessBlink = false;
            }
        }
    }

    private async Task AutoFormat()
    {
        if (_editor == null || selectedLanguage != nameof(ProgrammingLanguage.CSharp)) return;
        var sourceCode = await _editor.GetValue();
        if (string.IsNullOrWhiteSpace(sourceCode)) return;

        var syntaxTree = CSharpSyntaxTree.ParseText(sourceCode);
        var formattedNode = syntaxTree.GetRoot().NormalizeWhitespace();
        await _editor.SetValue(formattedNode.ToFullString());
    }

    private async Task SubmitCode()
    {
        if (selectedTask == null || _editor == null) return;
        var sourceCode = await _editor.GetValue();
        if (string.IsNullOrWhiteSpace(sourceCode)) return;

        isSubmitting = true;
        submissionResult = null;
        syntaxErrors = null;
        try
        {
            submissionResult = await Api.SubmitCodeAsync(selectedTask.Id, sourceCode, selectedLanguage);

            // Subscribe TutorTerminal to receive real-time tutor feedback
            if (submissionResult?.Submission?.Id is Guid subId && tutorTerminal is not null)
            {
                await tutorTerminal.SubscribeToSubmission(subId);
            }
        }
        catch (Exception ex)
        {
            submissionResult = new SubmissionResultDto
            {
                Feedback = new FeedbackDto { IsSuccess = false, Summary = $"Error: {ex.Message}" }
            };
        }
        finally
        {
            isSubmitting = false;
        }
    }
}

<style>
    @@keyframes blink-green {
        0% { border-color: #198754; box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.25); }
        50% { border-color: #198754; box-shadow: 0 0 0 0.5rem rgba(25, 135, 84, 0.5); }
        100% { border-color: #dee2e6; box-shadow: none; }
    }
    .border-success-blink {
        animation: blink-green 1s ease-out;
        border-color: #198754 !important;
    }
    .placeholder-glow {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
    }
</style>
