@page "/tasks"
@using PracticePlatform.WebUi.Services
@using PracticePlatform.WebUi.Resources
@inject ApiClient Api
@inject IStringLocalizer<SharedResource> L
@rendermode InteractiveServer

<PageTitle>@L["Tasks_Title"]</PageTitle>

<h1>@L["Tasks_Title"]</h1>

<div class="mb-3">
    <a href="/tasks/create" class="btn btn-primary">@L["Tasks_CreateNew"]</a>
</div>

@if (_tasks == null)
{
    <p><em>@L["Loading"]</em></p>
}
else if (!_tasks.Any())
{
    <p>@L["Tasks_NoTasks"]</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>@L["Tasks_ColTitle"]</th>
                <th>@L["Tasks_ColDifficulty"]</th>
                <th>@L["Tasks_ColTags"]</th>
                <th>@L["Tasks_ColActions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var task in _tasks)
            {
                <tr>
                    <td>@task.Title</td>
                    <td>@task.DifficultyLevel</td>
                    <td>@(string.Join(", ", task.Tags))</td>
                    <td>
                        <a href="/tasks/edit/@task.Id" class="btn btn-sm btn-outline-secondary">@L["Edit"]</a>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteTask(task.Id)">@L["Delete"]</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<TaskDto>? _tasks;

    protected override async Task OnInitializedAsync()
    {
        await LoadTasks();
    }

    private async Task LoadTasks()
    {
        _tasks = await Api.GetTasksAsync();
    }

    private async Task DeleteTask(Guid id)
    {
        await Api.DeleteTaskAsync(id);
        await LoadTasks();
    }
}
