@using Microsoft.AspNetCore.SignalR.Client
@using PracticePlatform.WebUi.Resources
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<div class="tutor-terminal @(IsExpanded ? "expanded" : "collapsed")">
    <div class="tutor-header" @onclick="ToggleExpanded">
        <span class="tutor-icon">🤖</span>
        <span class="tutor-title">@L["Tutor_Title"]</span>
        @if (isWaiting)
        {
            <span class="tutor-status waiting">@L["Tutor_Thinking"]</span>
        }
        else if (messages.Count > 0)
        {
            <span class="tutor-status ready">@messages.Count @L["Tutor_Responses"]</span>
        }
        <span class="tutor-toggle">@(IsExpanded ? "▼" : "▲")</span>
    </div>

    @if (IsExpanded)
    {
        <div class="tutor-body" @ref="tutorBody">
            @if (messages.Count == 0 && !isWaiting)
            {
                <div class="tutor-empty">
                    <p>@L["Tutor_EmptyMessage"]</p>
                    <p class="text-muted small">@L["Tutor_EmptyHint"]</p>
                </div>
            }

            @foreach (var msg in messages)
            {
                <div class="tutor-message @msg.TypeClass">
                    <div class="tutor-message-header">
                        <span class="tutor-message-type">@GetTypeLabel(msg.ResponseType)</span>
                        <span class="tutor-message-time">@msg.Timestamp.ToString("HH:mm:ss")</span>
                    </div>
                    <div class="tutor-message-content">
                        @((MarkupString)msg.HtmlContent)
                    </div>
                    @if (!string.IsNullOrEmpty(msg.RawDiagnostics))
                    {
                        <details class="tutor-diagnostics">
                            <summary>@L["Tutor_RawDiagnostics"]</summary>
                            <pre>@msg.RawDiagnostics</pre>
                        </details>
                    }
                </div>
            }

            @if (isWaiting)
            {
                <div class="tutor-message thinking">
                    <div class="tutor-thinking-dots">
                        <span></span><span></span><span></span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public bool IsExpanded { get; set; } = true;

    private HubConnection? hubConnection;
    private readonly List<TutorMessage> messages = new();
    private bool isWaiting;
    private ElementReference tutorBody;
    private Guid? currentSubmissionId;

    protected override async Task OnInitializedAsync()
    {
        var hubUrl = Navigation.ToAbsoluteUri("/hubs/tutor")
            .ToString()
            .Replace(Navigation.BaseUri.TrimEnd('/'), "http://webapi");

        hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUrl)
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<TutorResponseDto>("ReceiveTutorResponse", OnTutorResponse);

        await hubConnection.StartAsync();
    }

    public async Task SubscribeToSubmission(Guid submissionId)
    {
        // Leave previous group if any
        if (currentSubmissionId.HasValue && hubConnection is not null)
        {
            await hubConnection.InvokeAsync("LeaveSubmission", currentSubmissionId.Value.ToString());
        }

        currentSubmissionId = submissionId;
        isWaiting = true;
        StateHasChanged();

        if (hubConnection is not null)
        {
            await hubConnection.InvokeAsync("JoinSubmission", submissionId.ToString());
        }
    }

    private void OnTutorResponse(TutorResponseDto response)
    {
        isWaiting = false;

        var msg = new TutorMessage
        {
            ResponseType = response.ResponseType ?? "feedback",
            Content = response.Content ?? "",
            RawDiagnostics = response.RawDiagnostics,
            Timestamp = response.Timestamp ?? DateTimeOffset.Now
        };

        messages.Add(msg);
        InvokeAsync(StateHasChanged);
    }

    private string GetTypeLabel(string responseType) => responseType switch
    {
        "hint" => L["Tutor_Hint"],
        "error" => L["Tutor_Error"],
        "safety" => L["Tutor_Fallback"],
        "feedback" => L["Tutor_Feedback"],
        _ => L["Tutor_Response"]
    };

    public void ClearMessages()
    {
        messages.Clear();
        isWaiting = false;
        StateHasChanged();
    }

    private void ToggleExpanded()
    {
        IsExpanded = !IsExpanded;
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    // ── Inner types ──

    private class TutorMessage
    {
        public string ResponseType { get; init; } = "feedback";
        public string Content { get; init; } = "";
        public string? RawDiagnostics { get; init; }
        public DateTimeOffset Timestamp { get; init; }

        public string TypeClass => ResponseType switch
        {
            "hint" => "msg-hint",
            "error" or "safety" => "msg-error",
            _ => "msg-feedback"
        };

        public string HtmlContent
        {
            get
            {
                var encoded = System.Net.WebUtility.HtmlEncode(Content);
                var formatted = encoded
                    .Replace("\n\n", "</p><p>")
                    .Replace("\n", "<br />");
                return $"<p>{formatted}</p>";
            }
        }
    }

    private class TutorResponseDto
    {
        public Guid SubmissionId { get; set; }
        public string? ResponseType { get; set; }
        public string? Content { get; set; }
        public string? RawDiagnostics { get; set; }
        public string? CorrelationId { get; set; }
        public DateTimeOffset? Timestamp { get; set; }
    }
}

<style>
    .tutor-terminal {
        border: 1px solid #363b45;
        border-radius: 12px;
        background: #1a1e26;
        overflow: hidden;
        transition: all 0.3s ease;
        margin-top: 1rem;
    }

    .tutor-terminal.collapsed {
        max-height: 48px;
    }

    .tutor-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        background: linear-gradient(135deg, #1e2330, #252b3b);
        cursor: pointer;
        user-select: none;
        border-bottom: 1px solid #363b45;
    }

    .tutor-icon { font-size: 1.2rem; }
    .tutor-title { font-weight: 600; color: #e1e4e8; flex: 1; }

    .tutor-status {
        font-size: 0.75rem;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
    }

    .tutor-status.waiting {
        background: rgba(255, 179, 0, 0.15);
        color: #ffb300;
        animation: pulse 1.5s ease-in-out infinite;
    }

    .tutor-status.ready {
        background: rgba(46, 160, 67, 0.15);
        color: #2ea043;
    }

    .tutor-toggle { color: #8b949e; font-size: 0.75rem; }

    .tutor-body {
        max-height: 400px;
        overflow-y: auto;
        padding: 1rem;
    }

    .tutor-empty {
        text-align: center;
        padding: 2rem 1rem;
        color: #8b949e;
    }

    .tutor-message {
        margin-bottom: 1rem;
        padding: 1rem;
        border-radius: 8px;
        border-left: 3px solid;
    }

    .tutor-message.msg-feedback {
        background: rgba(56, 139, 253, 0.08);
        border-left-color: #388bfd;
    }

    .tutor-message.msg-hint {
        background: rgba(255, 179, 0, 0.08);
        border-left-color: #ffb300;
    }

    .tutor-message.msg-error {
        background: rgba(248, 81, 73, 0.08);
        border-left-color: #f85149;
    }

    .tutor-message.thinking {
        background: rgba(139, 148, 158, 0.08);
        border-left-color: #8b949e;
        display: flex;
        justify-content: center;
        padding: 1.5rem;
    }

    .tutor-message-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
        font-size: 0.8rem;
    }

    .tutor-message-type { font-weight: 600; color: #e1e4e8; }
    .tutor-message-time { color: #8b949e; }

    .tutor-message-content {
        color: #c9d1d9;
        line-height: 1.6;
        font-size: 0.9rem;
    }

    .tutor-message-content p { margin-bottom: 0.5rem; }

    .tutor-diagnostics {
        margin-top: 0.75rem;
        font-size: 0.8rem;
    }

    .tutor-diagnostics summary {
        cursor: pointer;
        color: #8b949e;
        padding: 0.25rem 0;
    }

    .tutor-diagnostics pre {
        background: #0d1117;
        border: 1px solid #30363d;
        border-radius: 6px;
        padding: 0.75rem;
        color: #c9d1d9;
        font-size: 0.75rem;
        overflow-x: auto;
        margin-top: 0.5rem;
    }

    .tutor-thinking-dots span {
        display: inline-block;
        width: 8px;
        height: 8px;
        margin: 0 3px;
        border-radius: 50%;
        background: #8b949e;
        animation: bounce 1.4s infinite ease-in-out both;
    }

    .tutor-thinking-dots span:nth-child(1) { animation-delay: -0.32s; }
    .tutor-thinking-dots span:nth-child(2) { animation-delay: -0.16s; }

    @@keyframes bounce {
        0%, 80%, 100% { transform: scale(0); }
        40% { transform: scale(1); }
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }
</style>
