<section id="get-started" class="lead-form-section py-5 bg-primary text-white text-center">
    <div class="container">
        <h2 class="fw-bold mb-3">Ready to Start Your Onboarding?</h2>
        <p class="lead mb-5">Join the platform and level up your skills with PracticePlatform today.</p>

        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5 text-start">
                <div class="card shadow-lg border-0 text-dark p-4">
                    <div class="card-body">
                        @if (!isQualified)
                        {
                            <!-- Step 1: Low fidelity question (Breadcrumb Technique) -->
                            <h5 class="card-title fw-bold mb-3">What's your primary coding language?</h5>
                            <div class="d-grid gap-2 mb-3">
                                <button class="btn btn-outline-primary" @onclick="Qualify">C# / .NET</button>
                                <button class="btn btn-outline-secondary" @onclick="Qualify">Java</button>
                                <button class="btn btn-outline-secondary" @onclick="Qualify">Python</button>
                                <button class="btn btn-outline-secondary" @onclick="Qualify">Other</button>
                            </div>
                        }
                        else if (!isSubmitted)
                        {
                            <!-- Step 2: Collection form -->
                            <h5 class="card-title fw-bold mb-3">Great! Where should we send your invite?</h5>
                            <div class="mb-3">
                                <label class="form-label text-muted small">Work Email</label>
                                <input type="email" class="form-control" placeholder="you@company.com" @bind="email" />
                            </div>
                            <button class="btn btn-primary w-100 fw-bold" @onclick="Submit">Get Instant Access</button>
                        }
                        else
                        {
                            <!-- Success State -->
                            <div class="text-center py-4">
                                <h1 class="text-success mb-3">&#10003;</h1>
                                <h5 class="fw-bold">You're on the list!</h5>
                                <p class="text-muted mb-4">Check your inbox for further instructions.</p>
                                <a href="/practice" class="btn btn-primary px-4 fw-bold">Start Practicing Now</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private bool isQualified = false;
    private bool isSubmitted = false;
    private string email = "";

    private void Qualify()
    {
        isQualified = true;
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(email)) return;
        
        // Simulate API call
        await Task.Delay(500); 
        isSubmitted = true;
    }
}
