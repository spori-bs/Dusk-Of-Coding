@using PracticePlatform.WebUi.Resources
@inject IStringLocalizer<SharedResource> L

<section class="hero-section py-5 text-center bg-light">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 text-lg-start">
                <h1 class="display-4 fw-bold mb-3">@L["Hero_Title"]</h1>
                <p class="lead text-muted mb-4">
                    @L["Hero_Description"]
                </p>
                <a href="#get-started" class="btn btn-primary btn-lg px-5 py-3 shadow-sm rounded-pill">@L["Hero_CTA"]</a>
            </div>
            <div class="col-lg-6 mt-5 mt-lg-0">
                <!-- Image-first design: abstract representation of the product -->
                <img src="https://via.placeholder.com/600x400?text=PracticePlatform+Dashboard" alt="PracticePlatform Dashboard Preview" class="img-fluid rounded shadow-lg" />
            </div>
        </div>
    </div>
</section>

<style>
    .hero-section {
        background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);
        padding-top: 5rem !important;
        padding-bottom: 5rem !important;
    }
</style>
