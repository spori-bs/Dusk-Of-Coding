{
  "realm": "DuskOfCoding",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator role"
      },
      {
        "name": "student",
        "description": "Default student role"
      }
    ]
  },
  "users": [
    {
      "username": "student",
      "email": "student@example.com",
      "enabled": true,
      "realmRoles": [ "student" ],
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ]
    },
    {
      "username": "dusk-admin",
      "email": "admin@example.com",
      "enabled": true,
      "realmRoles": [ "admin" ],
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "webui",
      "enabled": true,
      "publicClient": false,
      "secret": "secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "rootUrl": "",
      "adminUrl": "",
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "webapi",
      "enabled": true,
      "bearerOnly": true
    }
  ]
}
